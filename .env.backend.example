# Optional: copy to .env.backend. Local synthetic configuration only.
# Default native PostgreSQL is already running on this machine; use a separate DB.
PO_BACKEND_HOST=127.0.0.1
PO_BACKEND_PORT=8014
PO_BACKEND_DATABASE_URL=postgresql+psycopg://gate_a:gate_a_local@127.0.0.1:55433/gate_a_backend_website
PO_BACKEND_LOCAL_API_TOKEN=local-backend-dev-only
PO_BACKEND_LIVE_PROCESSING_ENABLED=false
PO_BACKEND_EXTRACTION_MODEL=gpt-6.1-sol
PO_BACKEND_PROVIDER_STORE=false
PO_BACKEND_PROVIDER_TIMEOUT_SECONDS=60
# OPENAI_API_KEY is deliberately absent. Configure securely only when authorized later.
