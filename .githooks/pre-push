#!/bin/sh
# The preserved legacy root includes private source details and must stay local.
legacy=93a1b5c7fa1dd769db9bc60ec51205749c6faf5b
zeros=0000000000000000000000000000000000000000
root=$(git rev-parse --show-toplevel)
# Cut over 2026-10-15: prefer the pinned shared gate if this desk has it cloned locally
# (.framework-pin/, gitignored, set up once per desk: see .orchestration/commands.md).
# A push should not block on a network clone, so this does NOT clone on demand -- it falls
# back to the old local tool with a warning instead. po_gate.py is kept for exactly this.
if [ -f "$root/.framework-pin/tools/gate/gate.py" ]; then
    gate="$root/.framework-pin/tools/gate/gate.py"
    # set -- / "$@" keeps $root as one argument even when it contains spaces; a plain
    # string expanded unquoted below would word-split on them (found by review, PR #52).
    set -- --config "$root/.orchestration/gate.json"
else
    gate="$root/tools/gate/po_gate.py"
    set --
    echo "Note: .framework-pin not found locally; content scan ran on the retired tools/gate/po_gate.py. Set up .framework-pin once (.orchestration/commands.md) to use the current pinned gate here too. CI always uses the pinned gate regardless." >&2
fi
py=""
for c in python3 python py; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c "" >/dev/null 2>&1; then py=$c; break; fi
done
while read local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
    if git merge-base --is-ancestor "$legacy" "$local_sha" 2>/dev/null; then
        echo "Push refused: legacy private history must stay local. Use a branch descended from clean main." >&2
        exit 1
    fi
    if git ls-tree -r --name-only "$local_sha" | grep -E '^(data|output|tmp|\.venv)/|\.(gguf|safetensors|sqlite3|pt|pth)$' >/dev/null; then
        echo "Push refused: private/runtime files are tracked in the proposed revision." >&2
        exit 1
    fi
    # --- content scan (T-010): forbidden files and secrets, by content as well as by name ---
    if [ -f "$gate" ] && [ -n "$py" ]; then
        if [ "$remote_sha" = "$zeros" ]; then
            "$py" "$gate" "$@" scan --outgoing "$local_sha"
        else
            "$py" "$gate" "$@" scan --range "$remote_sha..$local_sha"
        fi
        if [ $? -ne 0 ]; then
            echo "Push refused: the content scan found a problem (see above)." >&2
            exit 1
        fi
    else
        echo "Warning: content scan skipped (Python or tools/gate not found). CI still scans." >&2
    fi
done
exit 0
