# Copy to .env.gate-a for optional LOCAL configuration; defaults also work.
# Synthetic local development credentials only. No provider key is needed.
PO_READER_ENVIRONMENT=local
PO_READER_HOST=127.0.0.1
PO_READER_PORT=8000
PO_READER_DATABASE_URL=postgresql+psycopg://gate_a:gate_a_local@127.0.0.1:55432/gate_a
PO_READER_DB_CONNECT_TIMEOUT_SECONDS=2
